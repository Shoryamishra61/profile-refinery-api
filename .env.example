# Optional operator API keys for protected legacy/batch endpoints.
# The public request-scoped extraction desk does not require one.
APP_API_KEYS=
# Optional separate key for the controlled protocol-probe endpoint.
APP_VALIDATION_API_KEY=
# Only "live" is supported. The service has no fixture mode.
APP_MODE=live
# Caller-side rate limiting.
APP_RATE_LIMIT_REQUESTS=30
APP_RATE_LIMIT_WINDOW_SECONDS=60

# LinkedIn session material for the owned account used by the backend.
# Extract from a logged-in browser (DevTools > Application > Cookies):
#   LINKEDIN_LI_AT     = value of the li_at cookie
#   LINKEDIN_JSESSIONID= value of the JSESSIONID cookie (quotes optional)
# Without these the service is deliberately NOT ready (503) and profile
# extraction fails closed with UPSTREAM_AUTH_REQUIRED.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
# Optional: full Cookie header from a logged-in browser request ("name=value; ...")
# supplements the two cookies above with the complete session context.
LINKEDIN_COOKIE=
# Optional single static proxy URL. Never use a rotating proxy pool.
LINKEDIN_EGRESS_PROXY=
LINKEDIN_USER_AGENT=
LINKEDIN_ACCEPT_LANGUAGE=

# Upstream request budget.
APP_UPSTREAM_TIMEOUT_SECONDS=12
APP_UPSTREAM_MAX_BYTES=8000000
APP_UPSTREAM_RETRIES=1
APP_SCHEMA_PATH=schemas/profile-response.schema.json
APP_OPERATION_REGISTRY_PATH=config/operation_registry.yaml

# Batch processing.
APP_BATCH_MAX_URLS=200
APP_BATCH_MAX_FILE_BYTES=5242880
APP_BATCH_CONCURRENCY=3
APP_BATCH_TIME_BUDGET_SECONDS=8

# Upstream governor (control plane for all LinkedIn traffic).
APP_UPSTREAM_CONCURRENCY=2
APP_UPSTREAM_BUCKET_CAPACITY=4
APP_UPSTREAM_REFILL_PER_MINUTE=12
APP_BREAKER_FAILURE_THRESHOLD=3
APP_BREAKER_COOLDOWN_SECONDS=300
APP_STORE_DIR=./.profile_refinery_store
