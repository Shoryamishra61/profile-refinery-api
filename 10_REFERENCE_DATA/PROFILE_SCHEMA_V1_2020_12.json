{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tross-linkedin-profile-v1.json",
  "title": "TrossLinkedInProfileResponse",
  "type": "object",
  "required": [
