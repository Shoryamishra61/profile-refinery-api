          "$ref": "#/$defs/field"
        },
        "name": {
          "$ref": "#/$defs/field"
        },
        "headline": {
          "$ref": "#/$defs/field"
        },
        "location": {
          "$ref": "#/$defs/field"
        },
        "about": {
          "$ref": "#/$defs/field"
        },
        "experience": {
          "$ref": "#/$defs/field"
        },
        "education": {
          "$ref": "#/$defs/field"
        },
        "skills": {
          "$ref": "#/$defs/field"
        },
        "certifications": {
          "$ref": "#/$defs/field"
        },
        "languages": {
          "$ref": "#/$defs/field"
        },
        "profile_image": {
          "$ref": "#/$defs/field"
        },
        "background_image": {
          "$ref": "#/$defs/field"
        },
        "volunteering": {
          "$ref": "#/$defs/field"
        },
        "projects": {
          "$ref": "#/$defs/field"
        },
        "publications": {
          "$ref": "#/$defs/field"
        },
        "honors": {
          "$ref": "#/$defs/field"
        },
        "courses": {
          "$ref": "#/$defs/field"
        },
        "organizations": {
          "$ref": "#/$defs/field"
        },
        "recommendations": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": [
        "viewer_context",
        "operations_attempted",
        "operations_succeeded",
        "warnings"
      ],
      "properties": {
        "viewer_context": {
          "type": "string"
        },
        "operations_attempted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operations_succeeded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "present",
        "not_provided",
        "not_visible_to_viewer",
        "not_available_from_endpoint",
        "upstream_failed",
        "parser_failed",
        "stale_or_expired",
        "unknown"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_operation",
        "observation_time",
        "parser_version"
      ],
      "properties": {
        "source_operation": {
          "type": "string"
        },
        "observation_time": {
          "type": "string",
          "format": "date-time"
        },
        "raw_entity_reference": {
