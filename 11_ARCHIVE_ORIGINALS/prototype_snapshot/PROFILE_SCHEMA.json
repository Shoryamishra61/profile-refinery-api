      ]
    },
    "CertificationEntry": {
      "type": "object",
      "properties": {
        "certification_urn": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "license_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "$ref": "#/definitions/DateObject"
        },
        "end_date": {
          "$ref": "#/definitions/DateObject"
        }
      },
      "required": [
        "certification_urn",
        "name",
        "authority"
      ]
    },
    "LanguageEntry": {
      "type": "object",
