        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "languages": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LanguageEntry"
          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "volunteering": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VolunteerEntry"
          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "projects": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProjectEntry"
          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "publications": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PublicationEntry"
          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "honors": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HonorEntry"
          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "courses": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CourseEntry"
          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "organizations": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OrganizationEntry"
          }
