{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NormalizedLinkedInProfile",
  "description": "Canonical schema for a browser-less, reverse-engineered LinkedIn profile API with strict status ontology and provenance.",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "properties": {
            "vanity_slug": {
              "type": "string"
            },
            "member_urn": {
              "type": "string",
              "pattern": "^urn:li:fsd_profile:[A-Za-z0-9_-]+$"
            },
            "profile_id": {
              "type": "string"
            }
          },
          "required": [
            "vanity_slug",
            "member_urn"
          ]
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "headline": {
      "$ref": "#/definitions/StringField"
    },
    "location": {
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "country_code": {
              "type": "string"
            },
            "postal_code": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name"
          ]
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "about": {
      "$ref": "#/definitions/StringField"
    },
    "profile_image": {
      "$ref": "#/definitions/ImageField"
    },
    "background_image": {
      "$ref": "#/definitions/ImageField"
    },
    "experience": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExperienceEntry"
          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "education": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EducationEntry"
          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "skills": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SkillEntry"
          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "certifications": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CertificationEntry"
          }
