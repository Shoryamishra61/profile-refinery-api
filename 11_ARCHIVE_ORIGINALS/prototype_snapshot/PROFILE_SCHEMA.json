          }
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    }
  },
  "required": [
    "identity",
    "headline",
    "location",
    "about",
    "profile_image",
    "background_image",
    "experience",
    "education",
    "skills",
    "certifications",
    "languages"
  ],
  "definitions": {
    "FieldStatus": {
      "type": "string",
      "enum": [
        "present",
        "not_provided",
        "not_visible_to_viewer",
        "not_available_from_endpoint",
        "not_loaded",
        "upstream_failed",
        "parser_failed",
        "stale_or_expired",
        "unknown"
      ]
    },
    "ProvenanceMetadata": {
      "type": "object",
      "properties": {
        "source_operation": {
          "type": "string"
        },
        "observation_time": {
          "type": "string",
          "format": "date-time"
        },
        "raw_entity_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalization_performed": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "source_operation",
        "observation_time",
        "schema_version"
      ]
    },
    "StringField": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "ImageField": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "raw_cdn_url": {
              "type": "string"
            },
            "vector_artifact_id": {
              "type": "string"
            },
            "expires_at": {
              "type": "integer"
            }
          },
          "required": [
            "raw_cdn_url"
          ]
        },
        "status": {
          "$ref": "#/definitions/FieldStatus"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceMetadata"
        }
      },
      "required": [
        "value",
        "status",
        "provenance"
      ]
    },
    "ExperienceEntry": {
      "type": "object",
      "properties": {
        "position_urn": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "company_name": {
          "type": "string"
        },
        "company_urn": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "$ref": "#/definitions/DateObject"
        },
        "end_date": {
          "$ref": "#/definitions/DateObject"
        },
        "location_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "grouped_promotions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PromotionItem"
          }
        }
      },
      "required": [
        "position_urn",
        "title",
        "company_name",
        "start_date"
      ]
    },
    "PromotionItem": {
      "type": "object",
      "properties": {
        "position_urn": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "start_date": {
          "$ref": "#/definitions/DateObject"
        },
        "end_date": {
          "$ref": "#/definitions/DateObject"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "position_urn",
        "title",
        "start_date"
      ]
    },
    "EducationEntry": {
      "type": "object",
      "properties": {
        "education_urn": {
          "type": "string"
        },
        "school_name": {
          "type": "string"
        },
        "school_urn": {
          "type": [
            "string",
            "null"
          ]
        },
        "degree_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_of_study": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "$ref": "#/definitions/DateObject"
        },
        "end_date": {
          "$ref": "#/definitions/DateObject"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "education_urn",
        "school_name"
      ]
    },
    "SkillEntry": {
      "type": "object",
      "properties": {
        "skill_urn": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "endorsement_count": {
          "type": "integer"
        }
      },
      "required": [
        "skill_urn",
