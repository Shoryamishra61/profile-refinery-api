{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tross.dev/schemas/linkedin-profile-response-1.0.0.json",
  "title": "Tross LinkedIn Profile Response",
  "type": "object",
  "required": ["schema_version", "input_url", "canonical_url", "observed_at", "partial", "retrieval", "profile", "meta"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "input_url": {"type": "string", "format": "uri", "maxLength": 2048},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.linkedin\\.com/in/[A-Za-z0-9_-]+$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "partial": {"type": "boolean"},
    "retrieval": {
      "type": "object",
      "required": ["mode", "source", "fixture", "requested_url", "canonical_url", "observed_at", "partial"],
      "properties": {
        "mode": {"enum": ["fixture", "live"]},
        "source": {"enum": ["synthetic_fixture", "linkedin"]},
        "fixture": {"type": "boolean"},
        "requested_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.linkedin\\.com/in/[A-Za-z0-9_-]+$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "partial": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["identity", "name", "headline", "location", "about", "experience", "education", "skills", "certifications", "languages", "profile_image", "background_image"],
      "properties": {
        "identity": {"$ref": "#/$defs/field"},
        "name": {"$ref": "#/$defs/field"},
        "headline": {"$ref": "#/$defs/field"},
        "location": {"$ref": "#/$defs/field"},
        "about": {"$ref": "#/$defs/field"},
        "experience": {"$ref": "#/$defs/field"},
        "education": {"$ref": "#/$defs/field"},
        "skills": {"$ref": "#/$defs/field"},
        "certifications": {"$ref": "#/$defs/field"},
        "languages": {"$ref": "#/$defs/field"},
        "profile_image": {"$ref": "#/$defs/field"},
        "background_image": {"$ref": "#/$defs/field"}
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": ["viewer_context", "operations_attempted", "operations_succeeded", "upstream_calls", "upstream_latency_ms", "warnings"],
      "properties": {
        "viewer_context": {"type": "string"},
        "operations_attempted": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "operations_succeeded": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "upstream_calls": {"type": "integer", "minimum": 0},
        "upstream_latency_ms": {"type": "number", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "status": {
      "enum": ["present", "not_provided", "not_visible_to_viewer", "not_available_from_endpoint", "upstream_failed", "parser_failed", "stale_or_expired", "unknown"]
    },
    "provenance": {
      "type": "object",
      "required": ["source_operation", "observation_time", "parser_version", "raw_entity_reference", "normalization_notes"],
      "properties": {
        "source_operation": {"type": "string", "minLength": 1},
        "observation_time": {"type": "string", "format": "date-time"},
        "parser_version": {"type": "string", "minLength": 1},
        "raw_entity_reference": {"type": ["string", "null"]},
        "normalization_notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["value", "status", "provenance"],
      "properties": {
        "value": true,
        "status": {"$ref": "#/$defs/status"},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "present"}}, "required": ["status"]},
          "then": {"properties": {"value": {"not": {"type": "null"}}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["upstream_failed", "parser_failed", "unknown"]}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
